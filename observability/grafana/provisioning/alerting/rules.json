        {
          "uid": "ta-slow-agent",
          "title": "Two consecutive slow healthchecks",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "The two latest healthchecks exceeded HEALTHCHECK_SLOW_SECONDS."
          },
          "labels": {
            "project": "ticketagents"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ticketagents-postgres",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "postgres",
                  "uid": "ticketagents-postgres"
                },
                "rawQuery": true,
                "rawSql": "WITH ranked AS (SELECT environment,agent,status,row_number() OVER(PARTITION BY environment,agent ORDER BY started_at DESC) AS rn FROM runs WHERE kind='healthcheck' AND started_at>now()-interval '7 days') SELECT now() AS time,environment||'/'||agent AS series,CASE WHEN count(*)=2 AND bool_and(status='Slow') THEN 1 ELSE 0 END::double precision AS value FROM ranked WHERE rn<=2 GROUP BY environment,agent",
                "format": "time_series",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
