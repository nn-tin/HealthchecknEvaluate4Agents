        {
          "uid": "ta-agent-error",
          "title": "Latest healthcheck is Error",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "Latest healthcheck failed. Open Agent Health Overview for details."
          },
          "labels": {
