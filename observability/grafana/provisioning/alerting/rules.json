{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "TicketAgents checks",
      "folder": "TicketAgents",
      "interval": "1m",
      "rules": [
        {
          "uid": "ta-missing-batch",
          "title": "Scheduled batch missing or incomplete",
          "condition": "C",
          "for": "1m",
          "noDataState": "OK",
          "execErrState": "Error",
          "isPaused": false,
          "annotations": {
            "summary": "A scheduled batch is overdue or does not contain all configured agents."
          },
          "labels": {
            "project": "ticketagents"
          },
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "ticketagents-postgres",
              "model": {
                "refId": "A",
                "datasource": {
                  "type": "postgres",
                  "uid": "ticketagents-postgres"
                },
                "rawQuery": true,
                "rawSql": "SELECT now() AS time,s.environment AS series, CASE WHEN EXISTS (SELECT 1 FROM expected_batches e LEFT JOIN batch_progress b ON b.environment=e.environment AND b.scheduled_for=e.scheduled_for WHERE e.environment=s.environment AND e.scheduled_for >= date_trunc('day',now() AT TIME ZONE s.timezone) AT TIME ZONE s.timezone AND e.scheduled_for+e.grace_minutes*interval '1 minute' < now() AND (b.batch_id IS NULL OR b.finished_at IS NULL OR b.completed_agents<b.expected_count OR b.status<>'completed')) THEN 1 ELSE 0 END::double precision AS value FROM schedule_settings s",
                "format": "time_series",
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": []
              }
            },
            {
              "refId": "C",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "query": {
                      "params": [
                        "C"
                      ]
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    },
                    "operator": {
                      "type": "and"
                    }
                  }
                ]
              }
            }
          ]
