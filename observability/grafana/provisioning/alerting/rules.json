              "model": {
                "refId": "A",
                "datasource": {
                  "type": "postgres",
                  "uid": "ticketagents-postgres"
                },
                "rawQuery": true,
                "rawSql": "SELECT now() AS time,environment||'/'||agent AS series,CASE WHEN status='Error' THEN 1 ELSE 0 END::double precision AS value FROM (SELECT DISTINCT ON(environment,agent) environment,agent,status FROM runs WHERE kind='healthcheck' AND started_at>now()-interval '24 hours' ORDER BY environment,agent,started_at DESC) latest",
