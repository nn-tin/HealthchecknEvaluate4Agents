DIFY_BASE_URL=http://localhost:8000/v1
DIFY_LATE_REQUEST_API_KEY=
DIFY_LEAVE_REQUEST_API_KEY=
DIFY_IT_HELPDESK_API_KEY=
DIFY_MEETING_BOOKING_API_KEY=
DIFY_LATE_REQUEST_LINK=https://aistudio.motivesfareast.com/app/<late-app-id>
DIFY_LEAVE_REQUEST_LINK=https://aistudio.motivesfareast.com/app/<leave-app-id>
DIFY_IT_HELPDESK_LINK=https://aistudio.motivesfareast.com/app/<helpdesk-app-id>
DIFY_MEETING_BOOKING_LINK=https://aistudio.motivesfareast.com/app/<bookroom-app-id>

QWEN_BASE_URL=https://your-qwen-endpoint/v1
QWEN_BEARER=
QWEN_MODEL=qwen36
QWEN_MAX_TOKENS=8192
INSTRUCTOR_MODE=JSON_SCHEMA

HEALTHCHECK_SLOW_SECONDS=10

# Host-side CLI; Docker Compose supplies these automatically to the scheduler.
DATABASE_URL=postgresql://ticketagents:your-writer-password@127.0.0.1:5433/ticketagents
RESULT_SINK=json,postgres
ENVIRONMENT=staging
DATABASE_STORE_TRANSCRIPT=false
DATABASE_REDACT_TRANSCRIPT=true
HEALTHCHECK_SCHEDULES=08:00,12:30
HEALTHCHECK_TIMEZONE=Asia/Ho_Chi_Minh
HEALTHCHECK_AGENTS=leave,late,helpdesk,bookroom
HEALTHCHECK_WEEKDAYS=mon-sun
HEALTHCHECK_MISFIRE_GRACE_MINUTES=15
EVALUATION_SCHEDULES=17:30
EVALUATION_TIMEZONE=Asia/Ho_Chi_Minh
EVALUATION_AGENTS=leave,late,helpdesk,bookroom
EVALUATION_WEEKDAYS=mon-sun
EVALUATION_MISFIRE_GRACE_MINUTES=15
